set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(PS5_SDK "$ENV{PS5_PAYLOAD_SDK}")
get_filename_component(PS5_PROJECT_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(PS5_MELONDS_WORK "${PS5_PROJECT_ROOT}/build/cores/melondsds")
set(CMAKE_C_COMPILER "${PS5_SDK}/bin/prospero-clang")
set(CMAKE_CXX_COMPILER "${PS5_SDK}/bin/prospero-clang++")
set(CMAKE_AR "${PS5_SDK}/bin/prospero-ar")
set(CMAKE_RANLIB "${PS5_SDK}/bin/prospero-ranlib")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH "${PS5_SDK}/target")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_C_FLAGS_INIT "-fPIC -DPS5=1 -include ${CMAKE_CURRENT_LIST_DIR}/compat.h")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-nostdlib -nodefaultlibs -Wl,-z,undefs -Wl,--build-id=sha1 -Wl,-T,${PS5_PROJECT_ROOT}/tooling/native/ps5-core.ld -L${PS5_MELONDS_WORK}/empty-libs")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${CMAKE_MODULE_LINKER_FLAGS_INIT}")
