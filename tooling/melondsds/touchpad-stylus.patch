+#ifdef __PROSPERO__
+void CursorState::UpdateRelativeMouse() noexcept {
+    const int16_t dx = retro::input_state(0, RETRO_DEVICE_MOUSE, 0, RETRO_DEVICE_ID_MOUSE_X);
+    const int16_t dy = retro::input_state(0, RETRO_DEVICE_MOUSE, 0, RETRO_DEVICE_ID_MOUSE_Y);
+    const bool wasTouching = _mouseTouching;
+    _mouseTouching = retro::input_state(0, RETRO_DEVICE_MOUSE, 0, RETRO_DEVICE_ID_MOUSE_LEFT) != 0;
+    _isTouchReleased |= wasTouching && !_mouseTouching;
+    if (!dx && !dy && !wasTouching && !_mouseTouching) return;
+
+    if (_pointerCursorLastUpdate > _joypadCursorLastUpdate)
+        _joystickCursorPosition = _pointerCursorPosition;
+    // The native driver reports DualSense coordinates, as for DeSmuME's stylus.
+    _joystickCursorPosition += vec2(dx * 256.0f / 1920.0f, dy * 192.0f / 1080.0f);
+    _joystickCursorPosition = clamp(_joystickCursorPosition, vec2(0.0f), NDS_SCREEN_SIZE<float> - 1.0f);
+    _joypadCursorTouching |= _mouseTouching;
+    _joypadCursorLastUpdate = cpu_features_get_perf_counter();
+    ResetCursorTimeout();
+}
+#endif
