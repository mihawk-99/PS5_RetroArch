* { box-sizing: border-box; }

body, div, header, nav, main, section, aside, footer, span, button, img, em {
    display: block;
}

body {
    width: 1920px;
    height: 1080px;
    margin: 0;
    overflow: hidden;
    background-color: #030d24;
    color: #f4f8ff;
    font-family: "Montserrat";
    font-size: 24px;
    font-style: normal;
    font-weight: 500;
    line-height: 38px;
}

button {
    margin: 0;
    padding: 0;
    border: 0px transparent;
    border-radius: 0px;
    background-color: transparent;
    color: #f4f8ff;
    font-family: "Montserrat";
    text-align: left;
    nav: auto;
}

#app-shell { position: relative; width: 1920px; height: 1080px; overflow: hidden; background-color: #030d24; }
#startup-splash { position: absolute; left: 0px; top: 0px; width: 1920px; height: 1080px; }
#startup-splash img { position: absolute; left: 0px; top: 0px; width: 1920px; height: 1080px; }
#header { position: absolute; left: 0px; top: 0px; width: 1920px; height: 96px; border-bottom: 1px #4f9adc; background-color: #081d3c; }
#brand-mark { position: absolute; left: 64px; top: 20px; width: 56px; height: 56px; color: #07182b; }
.prosperolight-brand-icon { position: absolute; left: 0px; top: 0px; width: 56px; height: 56px; }
#brand-name { position: absolute; left: 140px; top: 14px; width: 250px; height: 38px; font-size: 32px; line-height: 38px; letter-spacing: 1px; }
#brand-version { position: absolute; left: 140px; top: 52px; width: 180px; height: 30px; color: #84c9ff; font-size: 20px; line-height: 30px; }
#page-title { position: absolute; left: 500px; top: 23px; width: 470px; height: 50px; color: #c8eaff; font-size: 32px; line-height: 50px; }
#header-mode { position: absolute; left: 1370px; top: 30px; width: 486px; height: 36px; color: #84c9ff; font-size: 20px; line-height: 32px; text-align: right; }

.button-chrome { position: absolute; left: 0px; top: 0px; }
.nav-chrome { width: 304px; height: 72px; }
.host-chrome { width: 820px; height: 246px; }
.game-chrome { width: 480px; height: 470px; }
.app-chrome { width: 260px; height: 340px; }
.setting-chrome { width: 1380px; height: 88px; }
.action-chrome { width: 250px; height: 72px; }
.panel-chrome { position: absolute; left: 0px; top: 0px; }
.detail-panel-chrome { width: 530px; height: 478px; }
.launch-panel-chrome { width: 870px; height: 478px; }
.ready-panel-chrome { left: 28px; top: 358px; width: 474px; height: 68px; }
.nav-active, .nav-focused, .focused-chrome, .disabled-chrome { display: none; }
.nav-button.active > .nav-normal { display: none; }
.nav-button.active > .nav-active { display: block; }
.nav-button.focused > .nav-normal, .nav-button.focused > .nav-active { display: none; }
.nav-button.focused > .nav-focused { display: block; }
button.focused > .base-chrome { display: none; }
button.focused > .focused-chrome { display: block; }
.action-button.disabled > .base-chrome { display: none; }
.action-button.disabled > .disabled-chrome { display: block; }

#sidebar { position: absolute; left: 64px; top: 140px; width: 304px; height: 820px; overflow: hidden; }
.nav-button { position: absolute; left: 0px; width: 304px; height: 72px; color: #b6ddf8; font-size: 24px; line-height: 38px; }
.nav-button span { position: absolute; left: 24px; top: 17px; width: 250px; height: 38px; }
#nav-hosts { top: 0px; } #nav-games { top: 78px; } #nav-settings { top: 156px; }
.nav-button.active { color: #ffffff; }
#sidebar-rule { position: absolute; left: 0px; top: 266px; width: 304px; height: 1px; background-color: #4f9adc; }
.sidebar-section-label { position: absolute; left: 0px; top: 300px; width: 304px; height: 34px; color: #84c9ff; font-size: 20px; line-height: 30px; }
#sidebar-host-name { position: absolute; left: 0px; top: 344px; width: 304px; height: 38px; color: #ddf3ff; font-size: 24px; line-height: 34px; }
#sidebar-host-address { position: absolute; left: 0px; top: 384px; width: 304px; height: 34px; color: #b6ddf8; font-size: 20px; line-height: 30px; }

#content { position: absolute; left: 400px; top: 96px; width: 1456px; height: 908px; overflow: hidden; }
.screen { position: absolute; left: 0px; top: 0px; width: 1456px; height: 908px; overflow: hidden; }
.screen-heading { position: absolute; left: 34px; top: 44px; width: 720px; height: 68px; font-size: 48px; line-height: 68px; }
.screen-copy { position: absolute; left: 34px; top: 108px; width: 900px; height: 38px; color: #b6ddf8; font-size: 20px; line-height: 32px; }

.host-card { position: absolute; left: 34px; top: 164px; width: 820px; height: 246px; overflow: hidden; }
.host-monogram { position: absolute; left: 28px; top: 30px; width: 150px; height: 150px; color: #d9eaff; }
.host-medallion { position: absolute; left: 0px; top: 0px; width: 150px; height: 150px; }
.host-monogram-label { position: absolute; left: 0px; top: 0px; width: 150px; height: 150px; font-size: 40px; line-height: 150px; text-align: center; }
.host-name { position: absolute; left: 210px; top: 34px; width: 470px; height: 52px; font-size: 36px; line-height: 52px; }
.host-address { position: absolute; left: 210px; top: 91px; width: 360px; height: 38px; color: #b6ddf8; font-size: 24px; line-height: 36px; }
.status-dot { width: 18px; height: 18px; }
.status-icon { position: absolute; left: 0px; top: 0px; width: 18px; height: 18px; }
.status-online-icon { display: none; }
.status-dot.online > .status-offline-icon { display: none; }
.status-dot.online > .status-online-icon { display: block; }
.host-card .status-dot { position: absolute; left: 208px; top: 154px; }
.host-status { position: absolute; left: 236px; top: 144px; width: 320px; height: 36px; color: #63d8a2; font-size: 20px; line-height: 32px; }
.host-status.offline, .detail-ready.offline, .game-ready.offline, #footer-status.offline { color: #f6c86b; }
.host-action { position: absolute; left: 680px; top: 100px; width: 100px; height: 40px; color: #c8eaff; font-size: 20px; line-height: 34px; text-align: right; }
.host-position { position: absolute; left: 28px; top: 198px; width: 752px; height: 30px; color: #84c9ff; font-size: 20px; line-height: 28px; letter-spacing: 1px; text-align: right; }

.detail-panel, .launch-panel { position: absolute; left: 884px; top: 164px; width: 530px; height: 478px; border: 0px transparent; border-radius: 0px; background-color: transparent; }
.detail-kicker { position: absolute; left: 28px; top: 24px; width: 340px; height: 32px; color: #84c9ff; font-size: 20px; line-height: 30px; }
.detail-title { position: absolute; left: 28px; top: 62px; width: 460px; height: 54px; font-size: 32px; line-height: 52px; }
.detail-line { position: absolute; left: 28px; width: 180px; height: 34px; color: #84c9ff; font-size: 20px; line-height: 30px; }
.detail-value { position: absolute; left: 218px; width: 282px; height: 34px; color: #f4f8ff; font-size: 20px; line-height: 30px; text-align: right; }
.detail-line-0, .detail-value-0 { top: 148px; } .detail-line-1, .detail-value-1 { top: 202px; } .detail-line-2, .detail-value-2 { top: 256px; }
.detail-rule { position: absolute; left: 28px; top: 322px; width: 474px; height: 1px; background-color: #4f9adc; }
.detail-ready { position: absolute; left: 28px; top: 358px; width: 474px; height: 68px; color: #63d8a2; font-size: 24px; line-height: 68px; text-align: center; }

.action-button { position: absolute; top: 444px; width: 250px; height: 72px; font-size: 24px; line-height: 38px; }
.action-button span { position: absolute; left: 0px; right: 0px; top: 17px; height: 38px; text-align: center; }
.action-primary { left: 34px; }
.action-secondary { left: 300px; }
#add-host { left: 566px; }
.disabled { color: #679bcc; }
.action-status { position: absolute; left: 34px; top: 546px; width: 820px; height: 40px; color: #84c9ff; font-size: 20px; line-height: 32px; }

#games-page { position: absolute; left: 540px; top: 108px; width: 314px; height: 30px; color: #84c9ff; font-size: 20px; line-height: 28px; text-align: right; }
.game-card { position: absolute; width: 260px; height: 340px; overflow: hidden; }
.game-card-0 { left: 34px; top: 164px; } .game-card-1 { left: 312px; top: 164px; } .game-card-2 { left: 590px; top: 164px; }
.game-card-3 { left: 34px; top: 514px; } .game-card-4 { left: 312px; top: 514px; } .game-card-5 { left: 590px; top: 514px; }
.game-card.selected > .base-chrome { display: none; }
.game-card.selected > .focused-chrome { display: block; }
.app-index { position: absolute; left: 168px; top: 308px; width: 74px; height: 30px; color: #84c9ff; font-size: 20px; line-height: 28px; text-align: right; }
.app-placeholder { position: absolute; left: 58px; top: 18px; width: 144px; height: 204px; }
.app-name { position: absolute; left: 18px; top: 238px; width: 224px; height: 38px; overflow: hidden; font-size: 24px; line-height: 36px; white-space: nowrap; }
.app-meta { position: absolute; left: 18px; top: 276px; width: 224px; height: 30px; color: #b6ddf8; font-size: 20px; line-height: 28px; }
.app-state { position: absolute; left: 18px; top: 308px; width: 224px; height: 30px; color: #84c9ff; font-size: 20px; line-height: 28px; }
.app-state.running { color: #63d8a2; }
.game-detail-panel { position: absolute; left: 884px; top: 164px; width: 530px; height: 478px; }
#selected-app-position { position: absolute; left: 28px; top: 112px; width: 474px; height: 30px; color: #b6ddf8; font-size: 20px; line-height: 28px; }
.app-detail-label { position: absolute; left: 28px; width: 112px; height: 34px; color: #84c9ff; font-size: 20px; line-height: 30px; }
.app-detail-value { position: absolute; left: 146px; width: 356px; height: 34px; color: #f4f8ff; font-size: 20px; line-height: 30px; text-align: right; }
.app-detail-line-0 { top: 166px; } .app-detail-line-1 { top: 220px; } .app-detail-line-2 { top: 274px; }
.games-stop { left: 884px; top: 670px; }
.games-back { left: 1164px; top: 670px; }
.games-status { left: 34px; top: 862px; width: 1380px; }

.setting-row { position: absolute; left: 34px; width: 1380px; height: 88px; overflow: hidden; }
.setting-row-0 { top: 164px; } .setting-row-1 { top: 258px; } .setting-row-2 { top: 352px; } .setting-row-3 { top: 446px; } .setting-row-4 { top: 540px; } .setting-row-5 { top: 634px; } .setting-row-6 { top: 728px; }
.setting-name { position: absolute; left: 28px; top: 5px; width: 450px; height: 40px; font-size: 24px; line-height: 38px; }
.setting-help { position: absolute; left: 28px; top: 43px; width: 700px; height: 34px; color: #84c9ff; font-size: 20px; line-height: 30px; }
.setting-value { position: absolute; left: 900px; top: 23px; width: 430px; height: 42px; color: #c8eaff; font-size: 24px; line-height: 38px; text-align: right; }
.setting-fixed { border-color: #376b9b; background-color: #0a254a; }
.settings-note { position: absolute; left: 34px; top: 838px; width: 1320px; height: 38px; color: #84c9ff; font-size: 20px; line-height: 30px; }

#controller-footer { position: absolute; left: 0px; top: 1004px; width: 1920px; height: 76px; border-top: 1px #4f9adc; background-color: #081d3c; }
.controller-hint { position: absolute; top: 16px; height: 44px; color: #b6ddf8; }
.controller-hint img { position: absolute; left: 0px; top: 0px; width: 40px; height: 40px; }
.controller-hint span { position: absolute; top: 0px; height: 42px; font-size: 20px; line-height: 38px; white-space: nowrap; }
.hint-select { left: 64px; width: 140px; } .hint-select span, .hint-back span, .hint-stop span, .hint-refresh span, .hint-options span { left: 50px; }
.hint-back { left: 220px; width: 130px; }
.hint-stop { left: 374px; width: 140px; }
.hint-refresh { left: 532px; width: 170px; }
.hint-options { left: 720px; width: 180px; }
.hint-nav { left: 924px; width: 220px; } .hint-nav span { left: 0px; color: #f4f8ff; } .hint-nav em { position: absolute; left: 96px; top: 0px; color: #b6ddf8; font-size: 20px; font-style: normal; line-height: 38px; }
#footer-status-dot { position: absolute; left: 1608px; top: 28px; }
#footer-status { position: absolute; left: 1638px; top: 19px; width: 218px; height: 38px; color: #63d8a2; font-size: 20px; line-height: 32px; text-align: right; }

#pair-modal { position: absolute; left: 0px; top: 0px; width: 1920px; height: 1080px; background-color: rgba(3, 13, 36, 0.78); }
#pair-dialog { position: absolute; left: 695px; top: 301px; width: 530px; height: 478px; }
.pair-dialog-chrome { position: absolute; left: 0px; top: 0px; width: 530px; height: 478px; }
.pair-dialog-kicker { position: absolute; left: 28px; top: 30px; width: 474px; height: 32px; color: #84c9ff; font-size: 20px; line-height: 30px; text-align: center; }
.pair-dialog-title { position: absolute; left: 28px; top: 76px; width: 474px; height: 44px; color: #f4f8ff; font-size: 28px; line-height: 42px; text-align: center; }
#pair-modal-pin { position: absolute; left: 28px; top: 136px; width: 474px; height: 72px; color: #f6c86b; font-size: 48px; line-height: 68px; letter-spacing: 14px; text-align: center; }
.pair-dialog-time-label { position: absolute; left: 28px; top: 234px; width: 474px; height: 32px; color: #84c9ff; font-size: 20px; line-height: 30px; text-align: center; }
#pair-modal-timer { position: absolute; left: 28px; top: 274px; width: 474px; height: 56px; color: #c8eaff; font-size: 36px; line-height: 52px; text-align: center; }
#pair-modal-status { position: absolute; left: 48px; top: 354px; width: 434px; height: 72px; color: #b6ddf8; font-size: 20px; line-height: 30px; text-align: center; }

.hidden { display: none; }
