+// Kept separate from the renderer so paused/cached source pixels stay native.
+static std::vector<uint32_t> ps5_xrgb_frame;
+static void ps5_video_frame(const void *pixels, unsigned width, unsigned height, size_t pitch)
+{
+    if (!pixels || nBurnBpp == 4)
+    {
+        video_cb(pixels, width, height, (pixels ? pitch : (size_t)width * 4));
+        return;
+    }
+    if (nBurnBpp != 2 || !width || !height || (size_t)width > SIZE_MAX / height)
+    {
+        log_cb(RETRO_LOG_ERROR, "[FBNeo PS5] Invalid frame dimensions/depth.\n");
+        return;
+    }
+    ps5_xrgb_frame.resize((size_t)width * height);
+    if (!ps5_fbneo_frame(ps5_xrgb_frame.data(), ps5_xrgb_frame.size(),
+                        static_cast<const uint16_t *>(pixels), pitch, width, height))
+    {
+        log_cb(RETRO_LOG_ERROR, "[FBNeo PS5] Invalid frame pitch.\n");
+        return;
+    }
+    video_cb(ps5_xrgb_frame.data(), width, height, (size_t)width * sizeof(uint32_t));
+}
