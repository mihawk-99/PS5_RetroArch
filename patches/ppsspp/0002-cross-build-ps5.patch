diff --git a/CMakeLists.txt b/CMakeLists.txt
index 65e2b49..e5de499 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -311,11 +311,16 @@ include_directories(ext/glew)
 
 if(OPENXR AND NOT ARMV7_DEVICE)
 	set(OPENGL_LIBRARIES GLESv3 EGL)
-elseif(NOT OPENGL_LIBRARIES AND USING_GLES2)
+elseif(NOT OPENGL_LIBRARIES AND USING_GLES2 AND NOT PPSSPP_PS5)
 	set(OPENGL_LIBRARIES GLESv2 EGL)
 endif()
 
-if(NOT OPENGL_LIBRARIES)
+# PS5: the GL/GLES backends compile against the SDK's GLES2 headers for source
+# compatibility, but this platform links no host GL library and the payload SDK
+# has none to find. An empty OPENGL_LIBRARIES is the correct result here, not a
+# missing dependency: the backends this port actually runs are Vulkan and the
+# libretro software context.
+if(NOT OPENGL_LIBRARIES AND NOT PPSSPP_PS5)
 	if(POLICY CMP0072)
 		cmake_policy(SET CMP0072 NEW)
 	endif()
@@ -584,7 +589,10 @@ include_directories(ext/OpenXR-SDK/include)
 include_directories(ext)
 
 include_directories(Common)
-if(USING_GLES2 OR (USING_EGL AND NOT USING_FBDEV))
+# PS5: GLES2 headers come from the payload SDK for source compatibility, but there
+# is no X11 and no GL/GLES library to search for. find_package(X11) here would leave
+# X11_Xlib_INCLUDE_PATH-NOTFOUND in the include list and fail generation.
+if((USING_GLES2 OR (USING_EGL AND NOT USING_FBDEV)) AND NOT PPSSPP_PS5)
 	find_package(X11)
 endif()
 
