diff --git a/Common/CPUDetect.cpp b/Common/CPUDetect.cpp
index c5dfa71..ec4da0b 100644
--- a/Common/CPUDetect.cpp
+++ b/Common/CPUDetect.cpp
@@ -30,6 +30,8 @@
 #include <fcntl.h>
 #elif PPSSPP_PLATFORM(MAC)
 #include <sys/sysctl.h>
+#elif PPSSPP_PLATFORM(PS5)
+#include <unistd.h>
 #endif
 
 #include <cstdint>
@@ -464,6 +466,28 @@ void CPUInfo::Detect() {
 			logical_cpu_count = num / std::max(num_cores, 1);
 		}
 	}
+#elif PPSSPP_PLATFORM(PS5)
+	// The payload SDK answers the online hardware-thread count through sysconf; there
+	// is no /proc and no sysctl name for it. The two fields are NOT two totals:
+	// ThreadManager::Init multiplies them (numRealCores * numLogicalCoresPerCpu), so
+	// they must be physical cores and threads per core. Setting both from sysconf
+	// (16 and 16 on this console) asked for 256 compute threads and 512 in total,
+	// which is what the first successful console load reported. Take the physical
+	// core count from CPUID leaf 0x80000008 like the AMD branch above, and derive
+	// SMT siblings from the online count.
+	{
+		long online = sysconf(_SC_NPROCESSORS_ONLN);
+		if (online > 0) {
+			num_cores = (int)online;
+			if (max_ex_fn >= 0x80000008) {
+				do_cpuid(cpu_id, 0x80000008);
+				const int physical = (cpu_id[2] & 0xFF) + 1;
+				if (physical > 0 && physical <= online)
+					num_cores = physical;
+			}
+			logical_cpu_count = (int)(online / std::max(num_cores, 1));
+		}
+	}
 #endif
 	if (logical_cpu_count <= 0)
 		logical_cpu_count = 1;
diff --git a/ppsspp_config.h b/ppsspp_config.h
index 7984a3d..f37fe2e 100644
--- a/ppsspp_config.h
+++ b/ppsspp_config.h
@@ -124,6 +124,12 @@
     #define PPSSPP_PLATFORM_LINUX 1
 #elif defined(__OpenBSD__)
     #define PPSSPP_PLATFORM_OPENBSD 1
+#elif defined(__PROSPERO__)
+    // PlayStation 5 homebrew through the public payload SDK. The target is a
+    // FreeBSD-ABI x86-64 ELF (clang -target x86_64-sie-ps5), which is neither
+    // Linux nor any of the BSDs above: it has no /proc, no dlopen of project
+    // shared objects, and its allocator is the console's own pools.
+    #define PPSSPP_PLATFORM_PS5 1
 #endif
 
 // Windows ARM/ARM64, and Windows UWP (all), are the only platform that don't do GL at all (until Apple finally removes it)
@@ -135,6 +141,10 @@
 #endif
 #elif PPSSPP_PLATFORM(IOS_APP_STORE)
 // No GL
+#elif PPSSPP_PLATFORM(PS5)
+// No GL: this port has no GL context driver and never selects PPSSPP's GL backend
+// (see Common/CMakeLists.txt). PPSSPP_API_ANY_GL also gates GPU/GPU.cpp's factory,
+// which is what turns a GLES request into a clean nullptr instead of a build.
 #else
 // All other platforms support GL.
 #define PPSSPP_API_ANY_GL 1
