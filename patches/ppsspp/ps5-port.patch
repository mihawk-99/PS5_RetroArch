+// PS5 test aid: /app0/ppsspp-options.txt, when present, holds `key=value` lines
+// that answer RETRO_ENVIRONMENT_GET_VARIABLE for those keys instead of the
+// frontend. The console's FTP server cannot read or write the frontend's
+// per-core options folder, so this is how a run sets options without a person
+// at the pad. The file is never shipped.
+static retro_environment_t ps5_frontend_environ_cb;
+static std::vector<std::pair<std::string, std::string>> ps5_option_overrides;
+
+static bool ps5_environ_cb(unsigned cmd, void *data) {
+   if (cmd == RETRO_ENVIRONMENT_GET_VARIABLE && data) {
+      struct retro_variable *var = (struct retro_variable *)data;
+      for (const auto &entry : ps5_option_overrides) {
+         if (var->key && entry.first == var->key) {
+            var->value = entry.second.c_str();
+            return true;
+         }
+      }
+   }
+   return ps5_frontend_environ_cb(cmd, data);
+}
+
+// A test flag from the same file: `name=1` present. Read by the GPU backend for
+// A/B runs (see GPU/Vulkan/GPU_Vulkan.cpp).
+bool PS5TestFlag(const char *name) {
+   for (const auto &entry : ps5_option_overrides)
+      if (entry.first == name && entry.second == "1")
+         return true;
+   return false;
+}
+
+static retro_environment_t ps5_wrap_environment(retro_environment_t cb) {
+   ps5_frontend_environ_cb = cb;
+   ps5_option_overrides.clear();
+   // POSIX reads: this file's FILE is libretro-common's RFILE.
+   int fd = open("/app0/ppsspp-options.txt", O_RDONLY);
+   if (fd >= 0) {
+      std::string text;
+      char chunk[512];
+      ssize_t got;
+      while ((got = read(fd, chunk, sizeof(chunk))) > 0)
+         text.append(chunk, (size_t)got);
+      close(fd);
+      size_t at = 0;
+      while (at < text.size()) {
+         size_t end = text.find('\n', at);
+         if (end == std::string::npos)
+            end = text.size();
+         std::string line = text.substr(at, end - at);
+         at = end + 1;
+         size_t eq = line.find('=');
+         if (eq == std::string::npos)
+            continue;
+         std::string key = line.substr(0, eq), value = line.substr(eq + 1);
+         while (!value.empty() && (value.back() == '\r' || value.back() == ' '))
+            value.pop_back();
+         while (!key.empty() && key.back() == ' ')
+            key.pop_back();
+         if (!key.empty())
+            ps5_option_overrides.emplace_back(key, value);
+      }
+   }
+   return ps5_option_overrides.empty() ? cb : ps5_environ_cb;
+}
+#endif
+
 void retro_set_environment(retro_environment_t cb)
 {
+#if PPSSPP_PLATFORM(PS5)
+   cb = ps5_wrap_environment(cb);
+#endif
    environ_cb = cb;
 
    bool option_categories = false;
