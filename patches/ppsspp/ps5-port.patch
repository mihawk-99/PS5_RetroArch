 u8* MemArena::Find4GBBase() {
+#if PPSSPP_PLATFORM(PS5)
+	// PS5: an anonymous PROT_NONE mapping of that size is charged to the title's
+	// small flexible-memory budget and fails, and the hardcoded fallback below
+	// would map over whatever lives there. The kernel's own virtual-range
+	// reservation holds 4 GiB without backing it; views are then mapped into it
+	// with MAP_FIXED. It is kept for the life of the process and reused.
+	// The address asked for is 0x6_0000_0000: outside the 4 GiB window at high
+	// word 2, which the console's Vulkan driver needs for every GPU-visible
+	// mapping (a first run without a hint landed at 0x2_0227_0000, in it).
+	static void *reserved = nullptr;
+	if (!reserved) {
+		void *address = (void *)0x600000000ULL;
+		const int32_t result = sceKernelReserveVirtualRange(&address, 0x100000000ULL, 0, 0x10000);
+		if (result != 0) {
+			ERROR_LOG(Log::MemMap, "PS5: reserving 4 GiB failed: %08x", (unsigned)result);
+			return nullptr;
+		}
+		reserved = address;
+		INFO_LOG(Log::MemMap, "PS5: guest address space reserved at %p (4 GiB)", reserved);
+	}
+	return static_cast<u8 *>(reserved);
+#endif
 	// Now, create views in high memory where there's plenty of space.
 #if PPSSPP_ARCH(64BIT) && !defined(USE_ASAN) && !defined(NO_MMAP)
 	// We should probably just go look in /proc/self/maps for some free space.
