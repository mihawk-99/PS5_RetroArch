diff --git a/Common/Thread/ThreadUtil.cpp b/Common/Thread/ThreadUtil.cpp
index e842a0312..12a87d20b 100644
--- a/Common/Thread/ThreadUtil.cpp
+++ b/Common/Thread/ThreadUtil.cpp
@@ -143,7 +143,11 @@ void SetCurrentThreadName(const char *threadName) {
 	pthread_setname_np(pthread_self(), threadName);
 #elif defined(__APPLE__)
 	pthread_setname_np(threadName);
-#elif defined(__DragonFly__) || defined(__FreeBSD__) || defined(__OpenBSD__)
+// PS5 is x86_64-sie-ps5, which defines __FreeBSD__, but its libkernel's
+// pthread_set_name_np is not usable from a title: calling it on a fresh worker thread
+// faults inside libkernel (fault address 0x70) and takes the process down. Skip it and
+// keep the name in the TLS variable the way the unknown-platform path does.
+#elif (defined(__DragonFly__) || defined(__FreeBSD__) || defined(__OpenBSD__)) && !PPSSPP_PLATFORM(PS5)
 	pthread_set_name_np(pthread_self(), threadName);
 #elif defined(__NetBSD__)
 	pthread_setname_np(pthread_self(), "%s", (void*)threadName);
