# This port's changes to RetroArch's own sources.
#
# Unlike a unified diff, these are applied by tools/apply-port-patches.py, which
# matches each change on a stable anchor line instead of a line number. The reason
# is in that file: a diff carries one revision's line numbers and applies in the
# wrong place, or not at all, when upstream moves.
#
# vendor/retroarch is never edited. The patches go to the configured copy under
# build/ra-conf/, so "upstream plus a named, re-runnable change" stays true.
#
# 0001  register the PS5 video driver   gfx/video_driver.{h,c}
0001-register-the-ps5-video-driver
#
# 0002  declare HAVE_XKBCOMMON, the one optional library upstream checks for
#       without declaring, so that --disable-xkbcommon is accepted
#       qb/config.params.sh
0002-declare-have-xkbcommon
#
# 0003  rename upstream's `main` so the SDK's _start has one definition to reach
#       and rarch_main keeps the frontend's main loop (see the note in
#       tools/apply-port-patches.py: defining HAVE_MAIN instead compiles the loop
#       out, which is a title that initialises everything and exits)
#       retroarch.c
0003-rename-upstream-main
#
# 0004  guard input_joypad_analog_axis against a null joypad driver, which is this
#       console's normal state: without it the menu's analog read faults on the
#       second pass through the runloop (see tools/apply-port-patches.py)
#       input/input_driver.c
0004-guard-the-joypad-analog-read

# 0054  observe command completion, queue submission, presentation and menu draw inputs
0054-observe-vulkan-api-results

# 0055  convert the RGUI producer RGBA4444 channels to full-range RGBA8888
0055-correct-rgui-rgba8888-upload

# 0056  quiet steady-frame diagnostics and time Vulkan video preparation/submission/presentation
0056-quiet-vulkan-frame-timing

# 0057  retain startup/error logs without periodic successful-frame markers
0057-startup-only-frame-diagnostics

# 0058  reassert the title frontend logger after config parsing/rebuilt arguments
0058-preserve-frontend-development-log

# 0059  the first menu upload proves the handover; later updates must not write probes
0059-log-menu-handover-once

# 0060  pad the XMB ribbon uniform upload to the driver's 16-byte record size
0060-pad-xmb-ribbon-uniform

# 0061  expand XMB strips safely and submit the expanded vertex count
0061-correct-display-triangle-strip-expansion

# 0062  populate unused sampler layout slots for untextured menu effects
0062-bind-menu-effect-placeholder-texture

# 0063  seed the title asset path without Unix platform initialization and log XMB startup
0063-set-title-menu-asset-directory

# 0065  address the logical image inside driver-required row padding, including R8 fonts
0065-correct-padded-texture-coordinates

# 0066  isolate XMB sampling from unverified mip-chain layout
0066-single-level-menu-textures

# 0067  register the native PS5 PCM backend and select it by default
0067-native-ps5-audio

# Native platform paths, startup argument preservation and browser roots.
0068-native-ps5-frontend

# Supply the native executable path and enumerate through kernel getdents.
0069-native-executable-path
0070-native-directory-enumeration

# 0071  expose PS5 pad through the binding/menu joypad interface and auto profile
0071-register-native-ps5-joypad

# Refuse failed core selection before frontend teardown; stop a failed runloop.
0072-native-core-failure-recovery

# Route libretro dynamic loading through the native ELF core loader.
0073-native-elf-core-loader

# Opt-in native loader diagnostic verifies rejected loads preserve the live menu.
0074-native-core-recovery-diagnostic

# 0075 and 0077 are withdrawn. Both existed because this driver's B8G8R8A8_UNORM
#      entry was not a sampled one: the frontend's software core frames and its
#      menu images ask for that format, 0014's substitution turned them into
#      R8G8B8A8 images, and their bytes were then read in the wrong order - the
#      red and blue reversal. The entry is sampled now, so the frontend keeps
#      libretro's own byte order again. Their markers are in the WITHDRAWN tuple
#      of tools/apply-port-patches.py, which exchanges each insertion for the
#      upstream text it replaced.

0076-archive-read-error-diagnostics

0078-crop-padded-core-source

# Opt-in, bounded first-failure XMB context; no allocator or menu policy change.
0079-observe-xmb-allocation-context

# Compact XMB nodes, mapped menu objects and checked list construction.
0080-safe-xmb-list-allocations

# Preserve requested pixel order in asynchronous thumbnail loading.
0081-async-thumbnail-colour-order

# Native joypad defaults and live auto-binding recovery after reset.
0082-reset-native-input-defaults

# 0083  an image is the format it was asked for: 0014's substitution to
#       R8G8B8A8_UNORM is withdrawn, its usage mask kept, and 0027's and 0015's
#       comments re-stated for the reason each still has
0083-image-is-the-requested-format

# 0084  pick the display mode by size, then highest refresh: 120 Hz where the
#       driver offers it, 60 Hz where it does not; keep the refresh chosen
#       gfx/common/vulkan_common.c
0084-display-mode-highest-refresh
#
# 0085  report the chosen mode's refresh, make video_refresh_rate follow it, and
#       make a saved swap interval of 1 automatic above 100 Hz so a 60 FPS core
#       keeps its speed
#       gfx/drivers_context/khr_display_ctx.c
0085-report-the-display-refresh
#
# 0086  allocate the scaler's intermediate frames only for scaling, and fail a
#       screenshot whose conversion cannot be set up instead of calling an unset
#       converter (FBNeo's 4K screenshot crashed on a null call)
#       libretro-common/gfx/scaler/scaler.c
#       libretro-common/include/gfx/video_frame.h
#       tasks/task_screenshot.c
0086-scaler-frames-only-for-scaling
#
# 0087  line-buffer the log file, so a fault keeps the lines before it
#       verbosity.c (0088 replaces the buffering)
0087-line-buffered-log

# 0088  a 256 KiB log buffer, written out by the title's flusher (src/main.cpp):
#       line buffering wrote to the console's storage once a line on the
#       logging thread, which stalled frames while a save state loaded
#       verbosity.c
0088-log-buffer-for-the-flusher

# 0089  enable VK_KHR_get_physical_device_properties2 on the instance when it is
#       offered: a core on a Vulkan 1.0 instance reaches the *2 queries only
#       through it (Dolphin's allocator)
#       gfx/common/vulkan_common.c
0089-instance-properties2

# 0090  the synchronous Vulkan readback copies no more than the viewport its
#       caller allocated for: the cached frame it re-renders can recompute the
#       viewport, and a save-state thumbnail of Dolphin's frame overran by ~1 MB
#       gfx/drivers/vulkan.c
0090-readback-within-caller-viewport

# 0091  an emulated swap interval (each frame presented swap_interval times)
#       asks for (video_max_swapchain_images - 1) * interval + 1 images, so
#       the setting's frames of lookahead hold at 120 Hz as at 60 Hz
#       gfx/common/vulkan_common.c
0091-swap-interval-images
