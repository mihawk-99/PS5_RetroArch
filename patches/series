# This port's changes to RetroArch's own sources.
#
# Unlike a unified diff, these are applied by tools/apply-port-patches.py, which
# matches each change on a stable anchor line instead of a line number. The reason
# is in that file: a diff carries one revision's line numbers and applies in the
# wrong place, or not at all, when upstream moves.
#
# vendor/retroarch is never edited. The patches go to the configured copy under
# build/ra-conf/, so "upstream plus a named, re-runnable change" stays true.
#
# 0001  register the PS5 video driver   gfx/video_driver.{h,c}
0001-register-the-ps5-video-driver
#
# 0002  declare HAVE_XKBCOMMON, the one optional library upstream checks for
#       without declaring, so that --disable-xkbcommon is accepted
#       qb/config.params.sh
0002-declare-have-xkbcommon
#
# 0003  rename upstream's `main` so the SDK's _start has one definition to reach
#       and rarch_main keeps the frontend's main loop (see the note in
#       tools/apply-port-patches.py: defining HAVE_MAIN instead compiles the loop
#       out, which is a title that initialises everything and exits)
#       retroarch.c
0003-rename-upstream-main
#
# 0004  guard input_joypad_analog_axis against a null joypad driver, which is this
#       console's normal state: without it the menu's analog read faults on the
#       second pass through the runloop (see tools/apply-port-patches.py)
#       input/input_driver.c
0004-guard-the-joypad-analog-read

# 0054  observe command completion, queue submission, presentation and menu draw inputs
0054-observe-vulkan-api-results

# 0055  convert the RGUI producer RGBA4444 channels to full-range RGBA8888
0055-correct-rgui-rgba8888-upload

# 0056  quiet steady-frame diagnostics and time Vulkan video preparation/submission/presentation
0056-quiet-vulkan-frame-timing

# 0057  retain startup/error logs without periodic successful-frame markers
0057-startup-only-frame-diagnostics

# 0058  reassert the title frontend logger after config parsing/rebuilt arguments
0058-preserve-frontend-development-log

# 0059  the first menu upload proves the handover; later updates must not write probes
0059-log-menu-handover-once
