diff --git a/core/network/net_platform.h b/core/network/net_platform.h
index bf4fd41..1b480e2 100644
@@ -77,7 +77,17 @@
 static inline void set_non_blocking(sock_t fd)
 {
 #ifndef _WIN32
+#if defined(__PROSPERO__)
+	// A PS5 title cannot change socket flags: a ~0 timeout emulates
+	// non-blocking recv/send for the short waits the network code does.
+	struct timeval tv;
+	tv.tv_sec = 0;
+	tv.tv_usec = 1;
+	setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+	setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+#else
 	fcntl(fd, F_SETFL, O_NONBLOCK);
+#endif
 #else
 	u_long optl = 1;
 	ioctlsocket(fd, FIONBIO, &optl);

