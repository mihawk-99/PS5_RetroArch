 retro_log_printf_t log_cb = NULL;
 static retro_video_refresh_t video_cb = NULL;
+/* PS5: use the frontend's verified XRGB upload route, including NTSC output. */
+static void ps5_video_frame(const void *pixels, unsigned width, unsigned height, size_t pitch)
+{
+    static uint32_t output[MAX_SNES_WIDTH_4X * MAX_SNES_HEIGHT];
+    if (!pixels)
+    {
+        video_cb(NULL, width, height, (size_t)width * sizeof(uint32_t));
+        return;
+    }
+    if (!ps5_snes9x_frame(output, sizeof(output) / sizeof(output[0]),
+                         static_cast<const uint16_t *>(pixels), pitch, width, height))
+    {
+        if (log_cb)
+            log_cb(RETRO_LOG_ERROR, "PS5 frame exceeds conversion capacity or has invalid pitch.\n");
+        return;
+    }
+    video_cb(output, width, height, (size_t)width * sizeof(uint32_t));
+}
 static retro_audio_sample_t audio_cb = NULL;
 static retro_audio_sample_batch_t audio_batch_cb = NULL;
