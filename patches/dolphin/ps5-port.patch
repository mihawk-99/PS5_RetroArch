@@ -103,7 +105,42 @@ void* AllocateExecutableMemory(size_t size)
 
   int map_prot = PROT_READ | PROT_WRITE | PROT_EXEC;
 
+#ifdef __PROSPERO__
+  // PS5: a mapping asked for with PROT_EXEC is returned but does not execute;
+  // one mapped read-write and then made executable with mprotect does (the
+  // PPSSPP port's x86-64 JIT runs from such memory).
+  //
+  // The hint keeps JIT code out of 0x2_0000_0000 - 0x2_FFFF_FFFF, the window the
+  // console's Vulkan driver needs for GPU-visible memory: without it the first
+  // run's code landed at 0x2_2902_xxxx.
+  // The console refuses a hint it cannot place (ENOMEM for 0x7_0000_0000) rather
+  // than choosing elsewhere; 0x3_0000_0000, just above the GPU window, is
+  // accepted, and the others are fallbacks.
+  void* ptr = MAP_FAILED;
+  for (const uintptr_t hint : {uintptr_t{0x3'0000'0000}, uintptr_t{0x4'8000'0000},
+                               uintptr_t{0x5'0000'0000}})
+  {
+    ptr = mmap(reinterpret_cast<void*>(hint), size, PROT_READ | PROT_WRITE, map_flags, -1, 0);
+    if (ptr != MAP_FAILED)
+      break;
+  }
+  const uintptr_t start = reinterpret_cast<uintptr_t>(ptr);
+  if (ptr != MAP_FAILED && start < 0x3'0000'0000 && start + size > 0x2'0000'0000)
+  {
+    munmap(ptr, size);
+    ptr = MAP_FAILED;
+  }
+  if (ptr != MAP_FAILED && mprotect(ptr, size, map_prot) != 0)
+  {
+    fprintf(stderr, "dolphin ps5: mprotect for code failed (errno %d)\n", errno);
+    munmap(ptr, size);
+    ptr = MAP_FAILED;
+  }
+  if (ptr == MAP_FAILED)
+    fprintf(stderr, "dolphin ps5: no executable memory for %zu bytes (errno %d)\n", size, errno);
+#else
   void* ptr = mmap(nullptr, size, map_prot, map_flags, -1, 0);
+#endif
   if (ptr == MAP_FAILED)
     ptr = nullptr;
 #endif
